          "http": {
            "method": "GET",
            "url": "https://tv-api.com/:lang/API/SearchName/:apiKey/:expression",
            "params": [
              {
                "name": "lang",
                "value": "",
                "type": "path",
                "description": "Two-letter language code (e.g. en, fr, de, es, ru). Use 'en' for default."
              },
              {
                "name": "apiKey",
                "value": "",
                "type": "path",
                "description": "Account API key."
              },
              {
                "name": "expression",
                "value": "",

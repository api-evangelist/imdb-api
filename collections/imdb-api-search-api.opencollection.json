                "description": "URL-encoded search expression."
              }
            ]
          },
          "docs": "Search constrained to TV episodes."
        },
        {
          "info": {
            "name": "Search Companies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tv-api.com/:lang/API/SearchCompany/:apiKey/:expression",
            "params": [
              {
                "name": "lang",
                "value": "",
                "type": "path",

        {
          "info": {
            "name": "Advanced Search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tv-api.com/:lang/API/AdvancedSearch/:apiKey",
            "params": [
              {
                "name": "lang",
                "value": "",
                "type": "path",
                "description": "Two-letter language code (e.g. en, fr, de, es, ru). Use 'en' for default."
              },
              {
                "name": "apiKey",
                "value": "",
                "type": "path",
                "description": "Account API key."
              },
              {
                "name": "title",
                "value": "",
                "type": "query"
              },
              {
                "name": "genres",
                "value": "",
                "type": "query"
              },
              {
                "name": "title_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "num_votes",
                "value": "",
                "type": "query"
              },
              {
                "name": "runtime",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Faceted search supporting title, genre, type, votes, runtime and sort filters."
        }
      ]
    }
  ],
  "bundled": true
}